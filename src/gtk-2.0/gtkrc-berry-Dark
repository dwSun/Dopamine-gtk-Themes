# Based on Bridge by ScionicSpectre and Adwaita by GNOME
# vim:set ts=2 sw=2 sts=2 ai et:

# Declare the colours used throughout the theme.

# Text/base
gtk-color-scheme = "text_color:#FFFFFF\nbase_color:#2B2B2B"
# Foreground/background
gtk-color-scheme = "fg_color:#FFFFFF\nbg_color:#333333"
# Selected foreground/background
gtk-color-scheme = "selected_fg_color:#FFFFFF\nselected_bg_color:#FF6F91"
# Titlebar foreground/background
gtk-color-scheme = "titlebar_fg_color:#FFFFFF\ntitlebar_bg_color:#202020"
# Menus
gtk-color-scheme = "menu_color:#3C3C3C"
# Tooltips foreground/background
gtk-color-scheme = "tooltip_fg_color:#FFFFFF\ntooltip_bg_color:#616161"
# Links
gtk-color-scheme = "link_color:#FFB3C1\nvisited_link_color:#CE93D8"

# Set GTK settings
gtk-auto-mnemonics              = 1
gtk-primary-button-warps-slider = 1

# And hand over the control to the theme files
include "main.rc"
include "apps.rc"
include "hacks.rc"
